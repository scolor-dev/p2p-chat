<?xml version="1.0" encoding="utf-8"?><!--
   Android 12 以上の、クラウドバックアップと端末間のデータ移行の設定。

   端末の身元（deviceId と、暗号化した token）の DataStore ファイルは、どちらにも含めない。
   理由: token の暗号化に使う AES 鍵は Android Keystore の中にあり、バックアップも端末間の移行もされない。
   暗号文だけが復元されると、復号できない壊れた状態になる。復元後は「未登録」として、登録画面からやり直す。
   ファイル名は DataStoreDeviceIdentityStore.FILE_NAME と合わせること。
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore/device_identity.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/device_identity.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
